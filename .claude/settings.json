{
  "permissions": {
    "allow": [
      "Bash(kubectl:*)",
      "Bash(k3s ctr images ls:*)",
      "Bash(docker images:*)",
      "Bash(docker ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout:*)",
      "Bash(k3s ctr images import:*)",
      "Bash(k3s ctr images rm:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(rm:*)"
    ]
  }
}
